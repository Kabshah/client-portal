# Environments
APP_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:8080

# Database
# Required: PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/dbname?sslmode=disable

# Authentication
# Required: Secret for JWT signing
JWT_SECRET=your-secure-jwt-secret-here
JWT_EXPIRES_IN_HOURS=168
AUTH_COOKIE_NAME=n8n_saas_cookie

# Google OAuth (Optional: if using Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Cookies (Optional)
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Integrations
# Optional: Webhook URL for n8n or other services
N8N_WEBHOOK_URL=http://localhost:5678/webhook/client-onboarding-readiness

# SMTP Email Configuration (Required for sending approval emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# Use an App Password for Gmail, not your normal password
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Meetings (Optional)
MEETING_URL=https://cal.com/your-meeting-link
